---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout
  title="motobrief — motorcycle security research"
  description="Technical security and privacy research on the digital ecosystem of modern motorcycles: manufacturer apps, connected devices, and more."
  lang="en"
>
  <section class="mx-auto max-w-2xl px-6 py-20">

    <p
      class="text-xs text-zinc-600 mb-6 tracking-widest uppercase"
      style="font-family: var(--font-mono);"
    >
      security research
    </p>

    <h1
      class="text-4xl md:text-5xl font-semibold tracking-tight text-zinc-100 leading-tight"
      style="font-family: var(--font-sans);"
    >
      motobrief
    </h1>

    <p class="mt-5 text-lg text-zinc-400 max-w-xl leading-relaxed">
      Security and privacy research on the digital ecosystem of modern
      motorcycles.
    </p>

    <p class="mt-3 text-base text-zinc-600 max-w-xl">
      Manufacturer apps, connected devices, electronic anti-theft, data
      privacy.
    </p>

    <div class="mt-10 flex items-center gap-3">
      <span
        class="inline-flex items-center gap-1.5 text-xs text-zinc-500 border border-zinc-800 rounded px-3 py-1.5"
        style="font-family: var(--font-mono);"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-amber-500 animate-pulse"></span>
        coming soon
      </span>
    </div>

  </section>
</BaseLayout>
