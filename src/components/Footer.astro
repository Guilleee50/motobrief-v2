---
// src/components/Footer.astro
// Footer mínimo: año + nota legal + links externos.

const year = new Date().getFullYear();
---

<footer class="border-t border-zinc-800 mt-24">
  <div class="mx-auto max-w-2xl px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">

    <p
      class="text-xs text-zinc-600"
      style="font-family: var(--font-mono);"
    >
      © {year} motobrief — investigación independiente
    </p>

    <div class="flex items-center gap-5">
      <a
        href="https://github.com/Guilleee50"
        target="_blank"
        rel="noopener noreferrer"
        class="text-xs text-zinc-600 hover:text-zinc-400 transition-colors"
        style="font-family: var(--font-mono);"
      >
        github
      </a>
      <a
        href="mailto:contacto@motobrief.es"
        class="text-xs text-zinc-600 hover:text-zinc-400 transition-colors"
        style="font-family: var(--font-mono);"
      >
        contacto
      </a>
      <span
        class="text-xs text-zinc-800 select-none"
        style="font-family: var(--font-mono);"
        title="Responsible disclosure only"
      >
        responsible disclosure
      </span>
    </div>

  </div>
</footer>
