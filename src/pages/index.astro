---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="motobrief — investigación en seguridad de motocicletas"
  description="Análisis técnico de la seguridad y privacidad en el ecosistema de las motos modernas: apps de fabricantes, dispositivos conectados y más."
>
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight md:text-5xl">
      motobrief
    </h1>

    <p class="mt-6 text-lg text-zinc-400">
      Investigación en seguridad y privacidad aplicada al ecosistema de las
      motocicletas modernas.
    </p>

    <p class="mt-4 text-base text-zinc-500">
      Próximamente: análisis de apps de fabricantes, dispositivos conectados,
      antirrobo electrónico y más.
    </p>
  </main>
</BaseLayout>
